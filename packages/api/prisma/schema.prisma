generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum ContentType {
  VIDEO
  DOCUMENT
  QUIZ
  PRACTICE
}

enum EnrollmentType {
  TRIAL
  PAID
}

enum PayoutStatus {
  HELD
  PAID
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  CANCELED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model User {
  id             Int     @id @default(autoincrement())
  email          String  @unique @db.VarChar(320)
  username       String  @unique @db.VarChar(64)
  hashedPassword String  @db.VarChar(100)
  firstName      String? @db.VarChar(100)
  lastName       String? @db.VarChar(100)
  role           Role    @default(STUDENT)

  stripeCustomerId      String? @unique @db.VarChar(100)
  stripePaymentMethodId String?         @db.VarChar(100)

  coursesAsTeacher Course[]      @relation("TeacherCourses")
  enrollments      Enrollment[]
  quizAttempts     QuizAttempt[]
  payments         Payment[]
  reviews          Review[]
  comments         Comment[]
  practiceSubmissions PracticeSubmission[]
  contentCompletions  ContentCompletion[]
  projectSubmissions  ProjectSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminAuditLog {
  id          Int      @id @default(autoincrement())
  adminId     Int?
  admin       User?    @relation("AdminAuditActor", fields: [adminId], references: [id], onDelete: SetNull)
  action      String
  resource    String
  resourceId  String?
  description String?
  before      Json?
  after       Json?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([resource, createdAt])
  @@index([action, createdAt])
}

model Category {
  id      Int      @id @default(autoincrement())
  name    String   @unique @db.VarChar(100)
  courses Course[]
}

model Course {
  id                 Int     @id @default(autoincrement())
  title              String  @db.VarChar(200)
  description        String  @db.VarChar(5000)
  price              Decimal @db.Decimal(10, 2)
  trialDurationDays  Int?
  accessDurationDays Int?
  level              CourseLevel?

  teacherId Int
  teacher   User @relation("TeacherCourses", fields: [teacherId], references: [id])

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  modules     Module[]
  enrollments Enrollment[]
  projects    Project[]

  // Self-many-to-many: courses this course requires the student to have done first.
  prerequisites Course[] @relation("CoursePrerequisites")
  prerequisiteOf Course[] @relation("CoursePrerequisites")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // EPIC 2: Content moderation / approval flow
  status          CourseStatus @default(DRAFT)
  rejectionReason String?
  submittedAt     DateTime?
  reviewedById    Int?
  reviewedBy      User?        @relation("CourseReviewer", fields: [reviewedById], references: [id])
}

model Module {
  id    Int    @id @default(autoincrement())
  title String
  order Int

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  contents Content[]
}

model Content {
  id                 Int         @id @default(autoincrement())
  title              String
  order              Int
  contentType        ContentType
  videoUrl           String?
  durationInSeconds  Int?
  documentUrl        String?
  fileType           String?
  timeLimitInMinutes Int?
  isFreePreview      Boolean     @default(false)

  moduleId Int
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  questions    Question[]
  quizAttempts QuizAttempt[]
  comments     Comment[]
  practice     Practice?
  completions  ContentCompletion[]
}

model Project {
  id           Int      @id @default(autoincrement())
  courseId     Int
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  description  String
  requirements String?
  deadline     DateTime?

  submissions  ProjectSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

model ProjectSubmission {
  id              Int       @id @default(autoincrement())
  projectId       Int
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  studentId       Int
  student         User      @relation(fields: [studentId], references: [id])

  repoUrl         String
  commitsJson     Json?
  lastFetchedAt   DateTime?

  teacherFeedback String?
  teacherGrade    Int?

  submittedAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([studentId, projectId])
  @@index([projectId])
}

model ContentCompletion {
  id          Int      @id @default(autoincrement())
  studentId   Int
  student     User     @relation(fields: [studentId], references: [id])
  contentId   Int
  content     Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([studentId, contentId])
  @@index([studentId])
}

model Practice {
  id             Int      @id @default(autoincrement())
  contentId      Int      @unique
  content        Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  prompt         String
  starterCode    String?
  expectedOutput String?
  language       String   @default("plaintext")

  submissions    PracticeSubmission[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PracticeSubmission {
  id             Int      @id @default(autoincrement())

  practiceId     Int
  practice       Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  studentId      Int
  student        User     @relation(fields: [studentId], references: [id])

  submittedCode  String
  aiScore        Float?
  aiFeedback     String?

  createdAt      DateTime @default(now())

  @@index([studentId, practiceId, createdAt])
}

model Question {
  id           Int    @id @default(autoincrement())
  questionText String

  contentId Int
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  options          AnswerOption[]
  videoQuizMarkers VideoQuizMarker[]
}

model AnswerOption {
  id         Int     @id @default(autoincrement())
  optionText String
  isCorrect  Boolean

  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id             Int            @id @default(autoincrement())
  enrollmentDate DateTime       @default(now())
  progress       Float          @default(0)
  completionDate DateTime?
  // EPIC 1: trial vs paid
  type           EnrollmentType @default(PAID)
  // EPIC 2: expiry
  expiresAt      DateTime?
  isActive       Boolean        @default(true)

  type                 EnrollmentType @default(PAID)
  expiresAt            DateTime?
  trialCardFingerprint String?
  isActive             Boolean        @default(true)

  studentId Int
  student   User @relation(fields: [studentId], references: [id])

  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  payment           Payment?          @relation("EnrollmentPayment")
  review            Review?           @relation("EnrollmentReview")
  contentProgresses ContentProgress[]
  revenueLedger     RevenueLedger?
  certificate       Certificate?

  @@unique([studentId, courseId])
  @@index([trialCardFingerprint, courseId])
  @@index([studentId, isActive])
  @@index([expiresAt])
}

model Review {
  id         Int      @id @default(autoincrement())
  rating     Int
  comment    String?
  datePosted DateTime @default(now())

  enrollmentId Int        @unique
  enrollment   Enrollment @relation("EnrollmentReview", fields: [enrollmentId], references: [id])

  studentId Int
  student   User @relation(fields: [studentId], references: [id])
}

model QuizAttempt {
  id        Int      @id @default(autoincrement())
  score     Float
  startTime DateTime
  endTime   DateTime

  studentId Int
  student   User @relation(fields: [studentId], references: [id])

  quizContentId Int
  quizContent   Content @relation(fields: [quizContentId], references: [id])
}

model VideoQuizMarker {
  id           Int                   @id @default(autoincrement())
  contentId    Int
  content      Content               @relation(fields: [contentId], references: [id], onDelete: Cascade)
  timestampSec Int
  questionId   Int
  question     Question              @relation(fields: [questionId], references: [id], onDelete: Cascade)
  blockingMode VideoQuizBlockingMode @default(PAUSE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contentId, timestampSec, questionId])
  @@index([contentId, timestampSec])
  @@index([questionId])
}

// EPIC 3: Practice alongside theory
model Practice {
  id             Int     @id @default(autoincrement())
  prompt         String
  starterCode    String?
  expectedOutput String?
  rubric         String?
  language       String  @default("javascript")

  contentId Int     @unique
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  submissions PracticeSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PracticeSubmission {
  id            Int      @id @default(autoincrement())
  submittedCode String
  aiFeedback    String?
  score         Float?
  passed        Boolean  @default(false)
  submittedAt   DateTime @default(now())

  studentId  Int
  student    User     @relation(fields: [studentId], references: [id])
  practiceId Int
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  @@index([studentId, practiceId])
}

model Payment {
  id              Int           @id @default(autoincrement())
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus @default(PENDING)
  stripeSessionId String        @unique

  enrollmentId Int        @unique
  enrollment   Enrollment @relation("EnrollmentPayment", fields: [enrollmentId], references: [id])

  studentId Int
  student   User @relation(fields: [studentId], references: [id])

  revenueLedger RevenueLedger?

  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([status, createdAt])
}

model RevenueLedger {
  id           Int          @id @default(autoincrement())
  paymentId    Int          @unique
  payment      Payment      @relation(fields: [paymentId], references: [id])

  courseId     Int
  teacherId    Int

  // Snapshots at time-of-sale. Courses get renamed / teachers get
  // offboarded, but the ledger needs to stay explainable for audit
  // years later — don't JOIN against live rows for historical reports.
  courseTitleSnapshot  String @db.VarChar(200)
  teacherNameSnapshot  String @db.VarChar(200)
  teacherEmailSnapshot String @db.VarChar(320)
  feePctSnapshot       Decimal @db.Decimal(5, 2)

  grossAmount  Decimal @db.Decimal(10, 2)
  platformFee  Decimal @db.Decimal(10, 2)
  teacherShare Decimal @db.Decimal(10, 2)

  payoutStatus PayoutStatus @default(HELD)
  paidAt       DateTime?

  createdAt    DateTime     @default(now())

  @@index([teacherId, createdAt])
  @@index([payoutStatus])
}

// Stripe guarantees at-least-once delivery — a retry on a dropped ACK
// would double-enroll a student or double-book revenue. Insert a row
// keyed on event.id inside the same transaction; the unique constraint
// makes a duplicate land as P2002 and we short-circuit.
model StripeWebhookEvent {
  id          String   @id @db.VarChar(100)
  type        String   @db.VarChar(100)
  processedAt DateTime @default(now())
}

// EPIC 4: Revenue Ledger
model RevenueLedger {
  id           Int          @id @default(autoincrement())
  grossAmount  Float
  platformFee  Float
  teacherShare Float
  payoutStatus PayoutStatus @default(HELD)
  paidAt       DateTime?

  paymentId Int     @unique
  payment   Payment @relation(fields: [paymentId], references: [id])

  enrollmentId Int        @unique
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])

  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  teacherId Int
  teacher   User  @relation("TeacherLedger", fields: [teacherId], references: [id])

  createdAt DateTime @default(now())

  @@index([teacherId, payoutStatus])
  @@index([courseId])
  @@index([createdAt])
}

model Comment {
  id   Int    @id @default(autoincrement())
  text String

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  contentId Int
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  parentId Int?
  parent   Comment?  @relation("Replies", fields: [parentId], references: [id])
  replies  Comment[] @relation("Replies")

  createdAt DateTime @default(now())
}

model Promotion {
  id                Int       @id @default(autoincrement())
  code              String    @unique
  description       String?
  discountType      String
  discountValue     Float
  minPurchaseAmount Float?
  maxDiscountAmount Float?
  usageLimit        Int?
  usedCount         Int       @default(0)
  startDate         DateTime
  endDate           DateTime
  isActive          Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// EPIC 6: Project-based Learning
model Project {
  id           Int       @id @default(autoincrement())
  title        String
  description  String
  requirements String
  deadline     DateTime?

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  submissions ProjectSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectSubmission {
  id            Int    @id @default(autoincrement())
  repoUrl       String
  commitHistory Json   @default("[]")
  feedback      String?
  grade         Float?
  submittedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  studentId Int
  student   User @relation(fields: [studentId], references: [id])

  @@unique([projectId, studentId])
  @@index([projectId])
  @@index([studentId])
}

model DiscussionPost {
  id   Int    @id @default(autoincrement())
  text String

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  parentId Int?
  parent   DiscussionPost?  @relation("DiscussionReplies", fields: [parentId], references: [id])
  replies  DiscussionPost[] @relation("DiscussionReplies")

  createdAt DateTime @default(now())

  @@index([courseId, createdAt])
  @@index([parentId])
}

model Notification {
  id          Int              @id @default(autoincrement())
  userId      Int
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  message     String
  link        String?
  isRead      Boolean          @default(false)
  readAt      DateTime?
  sentEmailAt DateTime?
  dedupeKey   String?          @unique
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId, isRead, createdAt])
  @@index([userId, type, createdAt])
}

model UserNotificationPreference {
  id           Int              @id @default(autoincrement())
  userId       Int
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         NotificationType
  inAppEnabled Boolean          @default(true)
  emailEnabled Boolean          @default(true)

  @@unique([userId, type])
  @@index([userId])
}
