# Copy this file to `.env` and update DATABASE_URL with your PostgreSQL connection string.
# Example format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/elearning?schema=public"
JWT_SECRET="your-secret-key"
BCRYPT_SALT_ROUNDS=10

# Cloudinary Credentials
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# Stripe
STRIPE_SECRET_KEY=...
STRIPE_SUCCESS_URL=...
STRIPE_CANCEL_URL=...
STRIPE_WEBHOOK_SECRET=whsec_...

# LLM — Groq (free tier, OpenAI-compatible)
GROQ_API_KEY=gsk_...
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_SMART=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Embeddings — Google Gemini (free tier)
GEMINI_API_KEY=...
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Optional
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@elearning.vn
FROM_NAME=E-Learning Platform
ADMIN_EMAIL=
GITHUB_TOKEN=
